    image: redis:7.2.4-alpine
    container_name: aacsearch-redis
    <<: *x-logging
    restart: unless-stopped
    command: >
      redis-server
      --maxmemory            512mb
      --maxmemory-policy     allkeys-lru
      --maxmemory-samples    5
    networks:
      - aacsearch
    volumes:
      - aacsearch-redis:/data:rw

