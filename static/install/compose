x-logging: &x-logging
  logging:
    driver: 'json-file'
    options:
      max-file: '5'
      max-size: '10m'
services:
  traefik:
    image: traefik:2.11
    container_name: aacsearch-traefik
    <<: *x-logging
    command:
      - --providers.file.directory=/storage/config
      - --providers.file.watch=true
      - --providers.docker=true
      - --providers.docker.exposedByDefault=false
      - --providers.docker.constraints=Label(`traefik.constraint-label-stack`,`aacsearch`)
      - --entrypoints.aacsearch_web.address=:80
      - --entrypoints.aacsearch_websecure.address=:443
    restart: unless-stopped
    ports:
      - 80:80
      - 443:443
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - aacsearch-config:/storage/config:ro
      - aacsearch-certificates:/storage/certificates:ro
    depends_on:
      - aacsearch
    networks:
      - gateway
      - aacsearch

  aacsearch:
    image: aacsearch/aacsearch:1.8.0
    container_name: aacsearch
    <<: *x-logging
    restart: unless-stopped
    networks:
      - aacsearch
    labels:
      - traefik.enable=true
      - traefik.constraint-label-stack=aacsearch
      - traefik.docker.network=aacsearch
      - traefik.http.services.aacsearch_api.loadbalancer.server.port=80
      #http
      - traefik.http.routers.aacsearch_api_http.entrypoints=aacsearch_web
      - traefik.http.routers.aacsearch_api_http.rule=PathPrefix(`/`)
      - traefik.http.routers.aacsearch_api_http.service=aacsearch_api
      # https
      - traefik.http.routers.aacsearch_api_https.entrypoints=aacsearch_websecure
      - traefik.http.routers.aacsearch_api_https.rule=PathPrefix(`/`)
      - traefik.http.routers.aacsearch_api_https.service=aacsearch_api
      - traefik.http.routers.aacsearch_api_https.tls=true
    volumes:
      - aacsearch-uploads:/storage/uploads:rw
      - aacsearch-imports:/storage/imports:rw
      - aacsearch-cache:/storage/cache:rw
      - aacsearch-config:/storage/config:rw
      - aacsearch-certificates:/storage/certificates:rw
      - aacsearch-functions:/storage/functions:rw
      - aacsearch-sites:/storage/sites:rw
      - aacsearch-builds:/storage/builds:rw
